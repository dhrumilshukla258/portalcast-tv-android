<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- usesCleartextTraffic: most portalcast-server installs are reached over plain http on the LAN. -->
    <application
        android:name=".PortalcastApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PortalcastTV">

        <!-- Release builds can be profiled over adb (CPU samples and traces of startup and
             scrolling, Android 10+); nothing else changes. Google's guidance for measuring
             release builds, which are the ones that run smoothly. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.PortalcastTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
